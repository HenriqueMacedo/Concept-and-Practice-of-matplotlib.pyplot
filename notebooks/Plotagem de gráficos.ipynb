import matplotlib.pyplot as plt
import numpy as np

x = np.linspace(-40, 40, 500)

plt.title("Gráficos de sen(x) e sen(4x)")
plt.subplot(2, 1, 1)
plt.plot(x, np.sin(x), "--r")
plt.ylabel("sen(x)")

plt.subplot(2,1,2)
plt.plot(x, np.sin(4*x), ":b")
plt.xlabel("x")
plt.ylabel("sen(4x)")

y = np.exp(-0.25*x) * np.sin(x)
plt.plot(x, y, ":m", label="Gráfico de f(x)")
plt.legend()

plt.xlabel("x"); plt.ylabel("y")
plt.title("$ f(x) = e^{-x}/sin(x) $")
plt.xlim(1, 10), plt.ylim(-1, 2)
plt.grid(alpha=.1)

x = np.linspace(-20, 20, 100)

plt.subplot(2, 2, 1)
plt.title("Curva 1", fontsize=14)
plt.plot(x, np.sin(x)/x)
plt.xlabel("x1")
plt.ylabel("sen(x)/x")

plt.subplot(2, 2, 2)
plt.title("Curva 2", fontsize=14)
plt.plot(x, x*np.sin(x))
plt.xlabel("x2")
plt.ylabel("x*np.sin(x)")

plt.subplot(2, 2, 3)
plt.title("Curva 3", fontsize=14)
plt.plot(x, np.sin(x)/(x*x))
plt.xlabel("x3")
plt.ylabel("sen(x)/x^2")

plt.subplot(2, 2, 4)
plt.title("Curva 4", fontsize=14)
plt.plot(x, (x*x)*np.sin(x))
plt.xlabel("x4")
plt.ylabel("x^2*np.sin(x)")

plt.suptitle("$ Conjunto de curvas $", fontweight="bold",fontsize=18)
plt.tight_layout()
plt.figure(figsize=(8,6))
plt.show()
