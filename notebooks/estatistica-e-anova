    "import pandas as pd\n",
    "import statsmodels.api as sm\n",
    "from statsmodels.formula.api import ols\n",
    "\n",
    "# Dados dos grupos\n",
    "g2_baixa = [1.33, 1.25, 1.26, 1.31, 1.31, 1.24, 1.20, 1.41, 1.28, 1.46]\n",
    "g2_media = [1.30, 1.48, 1.37, 1.26, 1.20, 1.24, 1.33, 1.28, 1.37, 1.40]\n",
    "g2_alta  = [1.31, 1.32, 1.61, 1.35, 1.49, 1.36, 1.41, 1.43, 1.41, 1.43]\n",
    "\n",
    "g1_baixa = [1.31, 1.30, 1.20, 1.31, 1.30, 1.28, 1.155, 1.29, 1.45, 1.15]\n",
    "g1_media = [1.48, 1.35, 1.525, 1.45, 1.10, 1.50, 1.30, 1.50, 1.45, 1.40]\n",
    "g1_alta  = [1.43, 1.60, 1.80, 1.80, 1.55, 1.18, 1.35, 1.30, 1.38, 1.60]\n",
    "\n",
    "# Construindo o dataframe long\n",
    "df = pd.DataFrame({\n",
    "    \"grupo\": ([\"grupo2\"] * 30) + ([\"grupo1\"] * 30),\n",
    "    \"altura\": ([\"baixa\"] * 10 + [\"media\"] * 10 + [\"alta\"] * 10) * 2,\n",
    "    \"tempo\": g2_baixa + g2_media + g2_alta + g1_baixa + g1_media + g1_alta\n",
    "})\n",
    "\n",
    "modelo = ols(\"tempo ~ C(grupo) * C(altura)\", data=df).fit()\n",
    "anova = sm.stats.anova_lm(modelo, typ=2)\n",
    "print(anova)"
   ]
  }
