from scipy.stats import f_oneway

tempo1 = [1.48, 1.35, 1.525, 1.45, 1.1, 1.5, 1.3, 1.5, 1.45, 1.4]
tempo2 = [1.43, 1.6, 1.8, 1.8, 1.55, 1.18, 1.35, 1.3, 1.38, 1.6]
tempo3 = [1.31, 1.3, 1.2, 1.31, 1.3, 1.28, 1.155, 1.29, 1.45, 1.15]

f_statistics, p_value = f_oneway(tempo1, tempo2, tempo3)

print(f"F tempo: {f_statistics}")
print(f"P tempo: {p_value}")


