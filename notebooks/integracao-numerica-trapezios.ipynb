#ETAPA 1 - POLINÔMIO DE GRAU 1
#Calcule o valor da integral para o caso do polinômio de grau 1

print("O que eu fiz em sala de aula")
X = [3, 6] #Lista com os intervalos
h = X[1] - X[0]
Y = []
i = 0
for i in range(2):
  fx = 3*X[i] + 2
  Y.append(fx)
#Equação 1
A = (h/2) * (Y[0] + Y[1])
print (f"O resultado da integral é: {A}")

