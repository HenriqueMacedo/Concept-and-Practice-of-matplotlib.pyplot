#ETAPA 3 - ERRO DO MÉTODO DE INTEGRAÇÃO
#Calcular o erro de truncamento do método de integração
from sympy.printing.pretty.pretty_symbology import xstr
from sympy import diff, Symbol


x_int = np.array([a, b])
max_valor = None
#Algoritmo Derivada
xs = Symbol('x')
fun = (1/xs)**2 # xs é variável da função [poderia ser f(x), mas neste caso: fun(xs)]

for i in x_int:
  #segunda derivada de f(x)
  derivada2 = diff(fun, xs, 2) # o valor 2 no argumento diff indica que a derivada é de ordem 2.
  num = abs(derivada2.subs(xs, i)) #substitui x = i e tira o valor absoluto

  if max_valor is None or num > max_valor:
    max_valor = num
print (f"O valor máximo é: {max_valor: .4f}")

erro = (6*((h)**3) / 12) * max_valor
print (f"O erro de truncamento é: {erro: .9f}")

