    "# Questão 5\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "omega = np.linspace(-np.pi, np.pi, 10)\n",
    "z_inv = np.exp(-1j * omega)\n",
    "num = 1 - 2*z_inv + z_inv**2\n",
    "den = 1\n",
    "H_freq = num / den\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))\n",
    "fig.suptitle('Análise do Sistema - Questão 5', fontsize=14)\n",
    "\n",
    "ax1.stem(omega, 20 * np.log10(np.abs(H_freq)), linefmt='b-', markerfmt='bo', basefmt='r-')\n",
    "ax1.set_title('Magnitude Discreta')\n",
    "ax1.set_ylabel('Ganho (dB)')\n",
    "ax1.grid(True, linestyle='--')\n",
    "\n",
    "ax2.stem(omega, np.angle(H_freq), linefmt='g-', markerfmt='go', basefmt='r-')\n",
    "ax2.set_title('Fase Discreta')\n",
    "ax2.set_xlabel('Frequência Angular Ω (rad/amostra)')\n",
    "ax2.set_ylabel('Fase (rad)')\n",
    "ax2.grid(True, linestyle='--')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
