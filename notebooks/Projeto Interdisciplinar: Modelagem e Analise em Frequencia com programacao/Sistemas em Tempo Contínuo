    "# Questão 4\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "t0 = 0.1\n",
    "w = np.logspace(-2, 2, 1000)\n",
    "H_mag = 1 / (1j * w + 2)\n",
    "\n",
    "# Magnitude\n",
    "plt.figure(figsize=(8, 4))\n",
    "plt.semilogx(w, 20 * np.log10(np.abs(H_mag)), 'b')\n",
    "plt.title('Questão 4: Magnitude (dB) para qualquer t0')\n",
    "plt.xlabel('Frequência (rad/s)')\n",
    "plt.ylabel('Magnitude (dB)')\n",
    "plt.grid(True, which=\"both\", ls=\"-\")\n",
    "plt.show()\n",
    "\n",
    "# Fase para variados t0\n",
    "for i in range(0, 3):\n",
    "    t0_novo = t0 + i\n",
    "    H_novo = 1 / (1j * w + 2) * np.exp(-1j * w * t0_novo)\n",
    "\n",
    "    plt.figure(figsize=(8, 3))\n",
    "    plt.semilogx(w, np.angle(H_novo), 'g')\n",
    "    plt.title(f'Questão 4: Fase (rad) | t0 = {t0_novo}')\n",
    "    plt.xlabel('Frequência (rad/s)')\n",
    "    plt.ylabel('Fase (rad)')\n",
    "    plt.grid(True, which=\"both\", ls=\"-\")\n",
    "    plt.show()"
